FROM rust:1.90-bookworm AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        patchelf \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock pnpm-workspace.yaml package.json ./
COPY identity-wallet ./identity-wallet
COPY unime/src-tauri ./unime/src-tauri

RUN cargo build --release -p identity-wallet --bin iota_test_tx_server

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/iota_test_tx_server /usr/local/bin/iota_test_tx_server

ENV IOTA_TEST_TX_SERVER_BIND=0.0.0.0:8787
EXPOSE 8787

CMD ["iota_test_tx_server"]
